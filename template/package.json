{
  "name": "nakokit",
  "version": "0.1.0",
  "description": "Nakokit — full-stack web, Electron, and Android app.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:server": "bun --watch server/main.ts",
    "dev:web": "vite",
    "dev": "bun scripts/dev.ts",
    "build": "vite build",
    "start": "bun server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "doctor": "react-doctor --yes --blocking warning",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run doctor && bun test && bun run build",
    "desktop:dev": "bun run build && bun --cwd desktop run dev",
    "desktop:build": "bun run build && bun --cwd desktop run dist",
    "android:test": "cd android && ./gradlew testDebugUnitTest",
    "android:build": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.8",
    "@fontsource-variable/inter": "^5.3.0",
    "elysia": "^1.4.28",
    "lucide-react": "^1.15.0",
    "nakomponents": "github:QuillDev/nakomponents#57ced4251d654ec1b45527f6fd51976b35846107",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.3.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "oxlint": "^1.58.0",
    "react-doctor": "^0.9.23",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
