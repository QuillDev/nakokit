{
  "name": "nakokit",
  "version": "0.2.0",
  "description": "Interactive CLI scaffolder for QuillDev full-stack apps (React 19, Vite 8, Tailwind v4, nakomponents, Elysia + Eden, Electron, Android).",
  "type": "module",
  "private": false,
  "bin": {
    "nakokit": "./bin/nakokit.ts"
  },
  "files": [
    "bin",
    "src",
    "template"
  ],
  "scripts": {
    "start": "bun bin/nakokit.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings bin src tests",
    "test": "bun test ./tests/scaffold.test.ts",
    "test:e2e": "bun tests/e2e.ts",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "oxlint": "^1.58.0",
    "typescript": "^7.0.2"
  }
}
